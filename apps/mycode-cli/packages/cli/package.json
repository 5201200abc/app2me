{
  "name": "@mycode/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for mycode",
  "bin": {
    "mycode": "./dist/mycode.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/mycode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/mycode-cli run build --filter=!@mycode/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@mycode/adapters": "workspace:*",
    "@mycode/bootstrap": "workspace:*",
    "@mycode/contracts": "workspace:*",
    "@mycode/core": "workspace:*",
    "@mycode/dynamic-workflow-runtime": "workspace:*",
    "@mycode/i18n": "workspace:*",
    "@mycode/provider-node": "workspace:*",
    "@mycode/shared": "workspace:*",
    "@mycode/shared-types": "workspace:*",
    "@mycode/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
